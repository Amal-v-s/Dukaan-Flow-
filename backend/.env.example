# Runtime Environment (development, staging, production)
ENVIRONMENT=development

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
ACCESS_TOKEN_EXPIRE_SECONDS=28800

# Firestore backend. Local development can use the emulator by setting
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080. Otherwise use ADC:
#   gcloud auth application-default login
# On Google Cloud, attach a least-privilege service account to the runtime.
GOOGLE_CLOUD_PROJECT=dukaan-flow-b7928
FIRESTORE_DATABASE_ID=(default)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Optional Gemini Developer API adapter. Keep the real key server-side only.
AI_FEATURES_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_REQUEST_TIMEOUT_SECONDS=12
AI_MAX_OUTPUT_TOKENS=512
