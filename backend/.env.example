# Runtime Environment (development, staging, production)
ENVIRONMENT=development

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
ACCESS_TOKEN_EXPIRE_SECONDS=28800

# Optional Gemini Developer API adapter. Keep the real key server-side only.
AI_FEATURES_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_REQUEST_TIMEOUT_SECONDS=12
AI_MAX_OUTPUT_TOKENS=512
